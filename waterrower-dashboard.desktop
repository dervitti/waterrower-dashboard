[Desktop Entry]
Type=Application
Name=WaterRower Dashboard
Comment=S4 Live-Dashboard (USB + Server + Browser)
Keywords=rower;waterrower;training;usb;s4;
Icon=utilities-system-monitor
Categories=Sports;Utility;
Terminal=true
# Do not hardcode a machine path here.
# Install from your clone: bash scripts/install-launcher.sh
# That writes ~/.local/share/applications/waterrower-dashboard.desktop with Path/Exec set.
Exec=waterrower
StartupNotify=false
